# PAC - optional AI API keys (copy this file to ".env" or set them as environment variables).
# NEVER commit your real keys. All keys are optional - PAC works with a local Ollama model and no keys at all.
# You can also paste keys in PAC: Menu > Contacts and messages > Google Gemini & Free AI Setup...

# Google Gemini (Gemini 2.5 Flash / Pro) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq free cloud AI (Llama 3.3 70B) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter free models - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic Claude - https://console.anthropic.com
ANTHROPIC_API_KEY=
